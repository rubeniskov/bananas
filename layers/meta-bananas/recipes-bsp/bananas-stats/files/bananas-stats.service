[Unit]
Description=BanaNAS stats sampler — persists CPU/mem/network/disk/parts to /var/lib/bananas/stats.db
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=bananas
Group=bananas
ExecStart=/usr/bin/bananas-stats
# Shared StateDirectory with bananas-server. systemd creates the dir
# (mode 0700) and chowns to bananas:bananas on first start.
StateDirectory=bananas
StateDirectoryMode=0700
# RuntimeDirectory holds the live pub/sub Unix socket
# (`/run/bananas-stats/live.sock`) that bananas-server's WS bus and
# bananas-dashboard subscribe to. systemd recreates the dir on every
# start and removes it on stop — the socket lifecycle therefore tracks
# the daemon's lifetime exactly.
RuntimeDirectory=bananas-stats
RuntimeDirectoryMode=0750
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
# Keep memory bounded — sampler + writer fit easily in <64 MiB.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
