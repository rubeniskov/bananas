[Unit]
Description=BanaNAS LCD dashboard — live system tiles on the 5" RGB panel
# Conflicts with psplash on the same framebuffer; psplash quits when
# default.target is reached, so wait for that before claiming /dev/fb0.
After=multi-user.target bananas-stats.service psplash-start.service
Wants=bananas-stats.service
ConditionPathExists=/dev/fb0
# Don't bring up the dashboard on a serial-only boot — it has nothing
# to render to. /dev/fb0 only appears once sun4i-drm has bound the
# panel.

[Service]
Type=simple
# Runs as the bananas user but needs `video` + `render` groups to open
# /dev/dri/card0 (KMS) and `input` to read the touchscreen / kbd events
# Slint's linuxkms-noseat backend enumerates.
User=bananas
Group=bananas
SupplementaryGroups=video render input
ExecStart=/usr/bin/bananas-dashboard
Environment=RUST_LOG=info
# Slint linuxkms picks the device automatically; the explicit env var
# below makes the choice deterministic on multi-card systems and is
# documented for posterity even if there's only one card.
Environment=SLINT_BACKEND=linuxkms-noseat
Environment=SLINT_KMS_DEVICE=/dev/dri/card0
# Re-attempt forever — if the panel is briefly unavailable during a
# hot-plug the dashboard should come back, not give up.
Restart=always
RestartSec=3
MemoryMax=192M

[Install]
WantedBy=multi-user.target
