[Unit]
Description=BanaNAS internal API gateway (Unix socket)
# Doesn't need any specific extension to be up — startup logs missing
# manifests but keeps serving (with 404s) so a bad manifest never
# bricks the API surface. The public TCP listener belongs to
# bananas-webadmin; this daemon only listens on /run/bananas/router.sock,
# so we don't wait for network-online.target — that adds 5–10 s of boot
# for nothing (same reasoning as bananas-engine.service).
After=local-fs.target
RuntimeDirectory=bananas
RuntimeDirectoryMode=0755

[Service]
Type=simple
User=bananas
Group=bananas
ExecStart=/usr/bin/bananas-router
Environment=BANANAS_ROUTER_SOCKET=/run/bananas/router.sock
Environment=BANANAS_EXTENSIONS_DIR=/etc/bananas/extensions.d
# Manifest changes (opkg install/remove of an extension package)
# require a hard restart: the postinst of each extension package
# issues `systemctl restart bananas-router.service`. Restart is
# cheap (~50 ms); the correctness win over SIGHUP-driven re-read
# is keeping the manifest table immutable for the lifetime of a
# single process.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
