[Unit]
Description=BanaNAS root helper (NFS exports + group ops for bananas-server)
# Helper is a Unix-socket daemon — talks only to the local server crate
# over /run/bananas/helper.sock. No network, no DNS. Don't wait for
# network-online.target; that adds 5–10 s of boot for nothing.
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/bananas-helper
RuntimeDirectory=bananas
RuntimeDirectoryMode=0755
Environment=BANANAS_HELPER_SOCKET=/run/bananas/helper.sock
# `always` (not `on-failure`) so the helper's self-update path can
# exit(0) cleanly after swapping its own binary on disk and trust
# systemd to bring the new ELF back. Without `always`, `exit(0)` is
# treated as a deliberate stop and the helper would never restart —
# in-place upgrades of bananas-helper would leave the system without
# its root daemon. The only legitimate "stop forever" path is now an
# explicit `systemctl stop` from the operator, which is what we want.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
