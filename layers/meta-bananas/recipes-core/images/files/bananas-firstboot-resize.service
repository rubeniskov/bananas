[Unit]
Description=BanaNAS first-boot rootfs resize
# The guard file is touched on first successful resize. After that the
# unit is a no-op, but ConditionPathExists short-circuits it before
# even invoking the script — the cheapest possible idle cost.
ConditionPathExists=!/var/lib/bananas/firstboot-resize.done
# Run after rootfs is fully mounted AND the system bring-up tmpfiles /
# users / etc. have settled. The earlier draft used
# `WantedBy=local-fs.target` + `Before=systemd-tmpfiles-setup.service`,
# which produced a three-way ordering cycle (tmpfiles-setup After
# local-fs.target → us Before tmpfiles-setup → us WantedBy
# local-fs.target). systemd silently broke the cycle by skipping
# tmpfiles-setup itself, which cascaded into systemd-logind,
# systemd-hostnamed, chronyd, and DBus failing on every boot. ext4
# online resize works fine after sysinit, so there's no reason to fight
# the early-boot ordering — `WantedBy=multi-user.target` keeps us out
# of the boot-critical chain entirely.
After=local-fs.target sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/bananas-firstboot-resize
# A failure here is non-fatal: if it can't grow the partition (e.g.
# someone already grew it manually), the system should still boot. The
# script itself logs a clear reason on stderr.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
