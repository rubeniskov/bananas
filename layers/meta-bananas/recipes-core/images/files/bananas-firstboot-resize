#!/bin/sh
# bananas-firstboot-resize — on first boot from MMC:
#   1. shrink rootfs partition to leave RAM-sized tail (capped 1 GiB),
#   2. carve a linux-swap partition on the tail,
#   3. mkswap + swapon + persist to /etc/fstab via UUID,
#   4. grow rootfs to its new shorter end + online resize2fs.
#
# vm.swappiness=10 already lives at /etc/sysctl.d/90-bananas-swap.conf
# so swap stays cold on a NAS workload (write-endurance friendly).
#
# Skipped when the rootfs is NFS-mounted (the iterate-loop dev path) or
# when the resize has already run (guard file). Skipped if /etc/fstab
# already mentions swap so re-running on an upgraded image doesn't
# stack a second swap partition.

set -e

guard=/var/lib/bananas/firstboot-resize.done
if [ -e "$guard" ]; then
    exit 0
fi

src=$(findmnt -n -o SOURCE /)
case "$src" in
    /dev/mmcblk*)
        ;;
    *)
        # NFS / loop / overlay / unknown — log and skip. Don't write the
        # guard either, in case the image is later re-flashed onto MMC.
        echo "bananas-firstboot-resize: rootfs is on $src — not MMC, skipping" >&2
        exit 0
        ;;
esac

# /dev/mmcblk0p2  →  disk=/dev/mmcblk0  partno=2
part_name="${src#/dev/}"
disk_name=$(printf '%s' "$part_name" | sed 's/p[0-9]\+$//')
partno=$(printf '%s' "$part_name" | sed 's/.*p\([0-9]\+\)$/\1/')
disk="/dev/$disk_name"

if [ -z "$disk_name" ] || [ -z "$partno" ] || [ "$disk_name" = "$part_name" ]; then
    echo "bananas-firstboot-resize: could not parse $src as mmcblkXpN" >&2
    exit 1
fi

# ── Swap sizing ────────────────────────────────────────────────────────
# RAM size in KiB → swap MiB, capped at 1 GiB. The cap matters on a
# board with more RAM than this BPI (1 GB) — we don't want to carve
# 4 GiB of SD just to cover a corner case nobody hits.
ram_kib=$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo)
swap_mib=$(( ram_kib / 1024 ))
if [ "$swap_mib" -gt 1024 ]; then
    swap_mib=1024
fi
if [ "$swap_mib" -lt 64 ]; then
    # Sanity floor — if /proc/meminfo lied or RAM is tiny, don't carve
    # an unusably small partition. Skip swap entirely instead.
    swap_mib=0
fi

# Skip swap creation if /etc/fstab already declares one (e.g. the
# operator added a swapfile by hand) so we don't end up with two.
if grep -qE '^[^#]*\bswap\b' /etc/fstab 2>/dev/null; then
    echo "bananas-firstboot-resize: /etc/fstab already has swap — skipping carve" >&2
    swap_mib=0
fi

if [ "$swap_mib" -gt 0 ]; then
    echo "bananas-firstboot-resize: planning ${swap_mib} MiB swap on $disk" >&2

    # Disk size in MiB so we can compute partition end positions in MiB
    # rather than wrestling sectors. parted accepts MiB suffixes.
    disk_bytes=$(blockdev --getsize64 "$disk")
    disk_mib=$(( disk_bytes / 1024 / 1024 ))
    rootfs_end_mib=$(( disk_mib - swap_mib ))

    # Step 1: resize rootfs partition to leave a tail. parted resizepart
    # on a mounted, in-use partition is allowed — kernel re-reads the
    # table via partx -u afterwards. ---pretend-input-tty silences the
    # interactive Yes/No on overlapping operations.
    parted ---pretend-input-tty --script "$disk" \
        resizepart "$partno" "${rootfs_end_mib}MiB"
    partx -u "$disk"

    # Step 2: carve the swap partition. Allocate the next available
    # partition number (sgdisk reports a free slot when partitions
    # have been deleted; fresh image will just be partno+1).
    swap_partno=$(( partno + 1 ))
    parted ---pretend-input-tty --script "$disk" \
        mkpart primary linux-swap "${rootfs_end_mib}MiB" 100%
    partx -u "$disk"

    swap_dev="${disk}p${swap_partno}"
    if [ ! -b "$swap_dev" ]; then
        # Some kernels need a beat for /dev/ to populate the new node.
        sleep 1
    fi
    if [ ! -b "$swap_dev" ]; then
        echo "bananas-firstboot-resize: $swap_dev not present after partx; aborting swap setup" >&2
    else
        # Step 3: mkswap + swapon + persist via UUID (label-free; UUID
        # is generated by mkswap, stable across reboots).
        mkswap "$swap_dev"
        swap_uuid=$(blkid -s UUID -o value "$swap_dev" || true)
        swapon "$swap_dev" || echo "bananas-firstboot-resize: swapon failed (continuing)" >&2
        if [ -n "$swap_uuid" ] && ! grep -qE "^[^#]*UUID=$swap_uuid\b" /etc/fstab; then
            printf 'UUID=%s\tnone\tswap\tdefaults\t0 0\n' "$swap_uuid" >> /etc/fstab
        fi
    fi
fi

# ── Rootfs grow ────────────────────────────────────────────────────────
# When swap was carved, rootfs partition was already shrunk to
# rootfs_end_mib above. When swap was skipped, grow to the disk end.
if [ "$swap_mib" -eq 0 ]; then
    parted ---pretend-input-tty --script "$disk" resizepart "$partno" 100%
    partx -u "$disk"
fi

# Online ext4 grow — works whether we shrank+regrew (no-op) or
# expanded into freshly-freed space.
resize2fs "$src"

mkdir -p "$(dirname "$guard")"
touch "$guard"

echo "bananas-firstboot-resize: done"
