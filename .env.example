# Copy to .env and fill in. .env is gitignored — do not commit it.
# Loaded automatically by pixi tasks (build, reboot, wait-board-down) via
# `set -a; [ -f .env ] && . .env; set +a`. CI/CD systems should set these as
# masked secrets / variables instead of using a .env file.
#
# IMPORTANT: values containing '$' (such as the SHA-512 password hash) MUST
# be wrapped in single quotes; otherwise the shell sourcing pass expands
# '$6', '$Ie', etc. as variables and the value silently corrupts.

# CIDR or hostname allowed in the BPI's /etc/exports. Required at build time.
# Example:
#   NFS_EXPORT_NETWORK=192.168.1.0/24
NFS_EXPORT_NETWORK=

# SHA-512 hash for root login (serial / LCD console; SSH stays key-only).
# OPTIONAL. When unset, the image ships with the default placeholder
# password "bananas", flagged expired in /etc/shadow so first sign-in
# (console or web UI) forces a rotation before granting a session — the
# placeholder never sees real use beyond that step. Override only when
# you want a specific operator-known hash baked into the image.
# Generate with:
#   openssl passwd -6 -salt $(openssl rand -hex 8)
# Wrap in single quotes:
#   ROOT_PASSWORD_HASH='$6$your-salt$your-hash'
ROOT_PASSWORD_HASH=

# BPI hostname or IP — used by `pixi run reboot` / `pixi run iterate` to ssh
# into the running board. Required at iterate time (not at build time).
#   BPI_HOST=192.168.1.42
BPI_HOST=
